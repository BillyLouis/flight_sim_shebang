<Window x:Class="HomePage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HomePage"
        mc:Ignorable="d"
        Title="BJL Flight Sim" Height="750" Width="1080">
    <Grid x:Name="HomePageWindow">
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="Black"/>
                <GradientStop Color="#FF4B4646" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <TabControl HorizontalAlignment="Center" Height="721" Margin="0,10,0,0" VerticalAlignment="Top" Width="1060" Background="White">
            <TabItem x:Name="tbiHome" Header="Home">
                <Grid Background="#FFE5E5E5">
                    <Image x:Name="HomePage" HorizontalAlignment="Center" Height="676" VerticalAlignment="Center" Width="1054" Source="/Home_Page.png"/>
                </Grid>
            </TabItem>
            <TabItem x:Name="tbiReserved" Header="Launch">
                <Grid Background="#FFE5E5E5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="11*"/>
                        <ColumnDefinition Width="55*"/>
                        <ColumnDefinition Width="988*"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="LaunchPage" HorizontalAlignment="Left" Height="670" VerticalAlignment="Center" Width="1054" Source="/Home_Page.png" Grid.ColumnSpan="3"/>
                    <Button x:Name="btExit" Content="Exit" HorizontalAlignment="Left" Height="39" Margin="52,608,0,0" VerticalAlignment="Top" Width="202" Opacity="0.7" Foreground="#FFF1EFE7" FontSize="24" FontWeight="Normal" Click="btnExit_Click" FontFamily="Comic Sans MS" Grid.Column="2">
                        <Button.OpacityMask>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="Black"/>
                                <GradientStop Color="#FFDE3F3F" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.OpacityMask>
                        <Button.BorderBrush>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="Black"/>
                                <GradientStop Color="#FFE0C02D" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.BorderBrush>
                        <Button.Background>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="Black"/>
                                <GradientStop Color="#FFC17171" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Effect>
                            <DropShadowEffect/>
                        </Button.Effect>
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="20"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="btCabinScreen" Content="Cabin Screen" HorizontalAlignment="Left" Height="39" Margin="52,554,0,0" VerticalAlignment="Top" Width="202" Opacity="0.7" Foreground="#FFF1EFE7" FontSize="24" FontWeight="Normal" Click="btnCabin_Click" FontFamily="Comic Sans MS" Grid.Column="2">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="20"/>
                            </Style>
                        </Button.Resources>
                        <Button.OpacityMask>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="Black"/>
                                <GradientStop Color="#FFDE3F3F" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.OpacityMask>
                        <Button.BorderBrush>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="Black"/>
                                <GradientStop Color="#FFE0C02D" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.BorderBrush>
                        <Button.Background>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="Black"/>
                                <GradientStop Color="#FFC17171" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Effect>
                            <DropShadowEffect/>
                        </Button.Effect>
                    </Button>
                    <Button x:Name="btControlScreen" Content="Controls Screen" HorizontalAlignment="Left" Height="39" Margin="52,500,0,0" VerticalAlignment="Top" Width="202" Opacity="0.7" Foreground="#FFF1EFE7" FontSize="24" FontWeight="Normal" Click="btnControls_Click" FontFamily="Comic Sans MS" Grid.Column="2">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="20"/>
                            </Style>
                        </Button.Resources>
                        <Button.OpacityMask>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="Black"/>
                                <GradientStop Color="#FFDE3F3F" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.OpacityMask>
                        <Button.BorderBrush>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="Black"/>
                                <GradientStop Color="#FFE0C02D" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.BorderBrush>
                        <Button.Background>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="Black"/>
                                <GradientStop Color="#FFC17171" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Effect>
                            <DropShadowEffect/>
                        </Button.Effect>
                    </Button>
                    <Button x:Name="btDashBoard" Content="Dashboard" HorizontalAlignment="Left" Height="39" Margin="52,443,0,0" VerticalAlignment="Top" Width="202" Opacity="0.7" Foreground="#FFF1EFE7" FontSize="24" FontWeight="Normal" Click="btnDashboard_Click" FontFamily="Comic Sans MS" Grid.Column="2">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="20"/>
                            </Style>
                        </Button.Resources>
                        <Button.OpacityMask>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="Black"/>
                                <GradientStop Color="#FFDE3F3F" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.OpacityMask>
                        <Button.BorderBrush>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="Black"/>
                                <GradientStop Color="#FFE0C02D" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.BorderBrush>
                        <Button.Background>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="Black"/>
                                <GradientStop Color="#FFC17171" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Effect>
                            <DropShadowEffect/>
                        </Button.Effect>
                    </Button>
                </Grid>
            </TabItem>
            <TabItem x:Name="tbiAbout" Header="About">
                <Grid Background="#FFE5E5E5"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
